# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/whattoeat

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Optional: when omitted, backend derives issuer as ${SUPABASE_URL}/auth/v1
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Local/dev: set true so the app and `npm run test:api` can use `?user_id=` without a JWT. Use false in production.
ALLOW_QUERY_USER_ID=true

# Frontend (CORS)
FRONTEND_URL=http://localhost:3000

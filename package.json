{
  "name": "whattoeat-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:init": "tsx src/scripts/initDb.ts",
    "auth:cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.10",
    "typescript": "^5.8.2",
    "tsx": "^4.19.3"
  }
}